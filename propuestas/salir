@app.route("/productos/crear", methods=["POST"])
def productos_crear():
    """CREATE: Inserta un nuevo producto en la base de datos."""
    codigo = request.form.get("codigo", "").strip()
    nombre = request.form.get("nombre", "").strip()
    precio_venta = request.form.get("precio_venta", 0.0)
    stock_actual = request.form.get("stock_actual", 0)
    stock_minimo = request.form.get("stock_minimo", 0)

    if not codigo or not nombre:
        flash("El código y el nombre son obligatorios.", "warning")
        return redirect(url_for("productos"))

    conexion = get_db()
    if conexion:
        cursor = conexion.cursor()
        try:
            query = """
                INSERT INTO producto (codigo, nombre, precio_venta, stock_actual, stock_minimo)
                VALUES (%s, %s, %s, %s, %s)
            """
            cursor.execute(query, (codigo, nombre, precio_venta, stock_actual, stock_minimo))
            conexion.commit()
            flash(f"Producto '{nombre}' creado con éxito.", "success")
        except mysql.connector.IntegrityError:
            conexion.rollback()
            flash(f"Error: El código '{codigo}' ya está registrado.", "danger")
        except Error as e:
            conexion.rollback()
            flash(f"Error en la base de datos: {e}", "danger")
        finally:
            cursor.close()

    return redirect(url_for("productos"))

@app.route("/productos/editar/<codigo>", methods=["POST"])
def productos_editar(codigo):
    """UPDATE: Actualiza los datos de un producto."""
    nombre = request.form.get("nombre", "").strip()
    precio_venta = request.form.get("precio_venta")
    stock_actual = request.form.get("stock_actual")
    stock_minimo = request.form.get("stock_minimo")

    conexion = get_db()
    if conexion:
        cursor = conexion.cursor()
        try:
            query = """
                UPDATE producto 
                SET nombre = %s, precio_venta = %s, stock_actual = %s, stock_minimo = %s
                WHERE codigo = %s
            """
            cursor.execute(query, (nombre, precio_venta, stock_actual, stock_minimo, codigo))
            conexion.commit()
            flash(f"Producto #{codigo} actualizado correctamente.", "success")
        except Error as e:
            conexion.rollback()
            flash(f"Error al actualizar: {e}", "danger")
        finally:
            cursor.close()

    return redirect(url_for("productos"))

@app.route("/productos/eliminar/<codigo>", methods=["POST"])
