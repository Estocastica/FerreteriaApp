# =====================================
# CRUD PRODUCTOS: LISTADO
# =====================================

@app.route("/productos")
def productos():
    conexion = None
    cursor = None
    filas = []

    try:
        conexion = obtener_conexion()
        cursor = conexion.cursor()
        cursor.execute("""
            SELECT p.codigo,
                   p.nombre,
                   p.precio_venta,
                   p.stock_actual,
                   p.stock_minimo,
                   c.nombre
            FROM producto AS p
            LEFT JOIN categoria AS c
                ON c.id_categoria = p.id_categoria
            ORDER BY p.nombre
        """)
        filas = cursor.fetchall()
    except Exception as e:
        flash(f"Error al cargar productos: {e}", "danger")
    finally:
        if cursor:
            cursor.close()
        if conexion:
            conexion.close()

    mensajes_html = ""
    for categoria, mensaje in get_flashed_messages(with_categories=True):
        mensajes_html += f"""
        <div class="alert alert-{categoria} alert-dismissible fade show" role="alert">
            {html.escape(mensaje)}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
        """

    filas_html = ""
    for fila in filas:
        codigo = html.escape(str(fila[0]), quote=True)
        nombre = html.escape(str(fila[1]))
        precio = html.escape(f"{float(fila[2]):.2f}")
        stock = html.escape(str(fila[3]))
        stock_minimo = html.escape(str(fila[4]))
        categoria = html.escape(str(fila[5] or "Sin categoría"))

        filas_html += f"""
        <tr>
            <td class="fw-bold">{codigo}</td>
            <td>{nombre}</td>
            <td>${precio}</td>
            <td><span class="badge bg-secondary fs-6">{stock}</span></td>
            <td>{stock_minimo}</td>
            <td>{categoria}</td>
            <td class="text-end">
                <a href="/productos/editar/{codigo}" class="btn btn-sm btn-outline-primary me-1">✏ Editar</a>
                <form action="/productos/eliminar/{codigo}" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este producto?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">🗑 Eliminar</button>
                </form>
            </td>
        </tr>
        """

    if not filas:
        filas_html = """
        <tr>
            <td colspan="7" class="text-center text-muted py-4">No se encontraron productos registrados.</td>
        </tr>
        """

    return f"""
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Gestión de Productos</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light">
        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a href="/" class="btn btn-outline-secondary">🏠 Volver al Menú</a>
                <a href="/productos/nuevo" class="btn btn-success">+ Nuevo Producto</a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h2 class="h4 mb-0">📦 Catálogo de Productos</h2>
                    <span class="badge bg-light text-dark">{len(filas)} registros</span>
                </div>
                <div class="card-body">
                    {mensajes_html}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Código</th>
                                    <th>Producto</th>
                                    <th>Precio Venta</th>
                                    <th>Stock Actual</th>
                                    <th>Stock Mínimo</th>
                                    <th>Categoría</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {filas_html}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
    </html>
    """


# =====================================
# CRUD PRODUCTOS: CREAR
# =====================================

def validar_datos_producto(codigo, nombre, precio_venta, stock_actual, stock_minimo, id_categoria, requiere_codigo=True):
    if requiere_codigo and not codigo:
        raise ValueError("El código es obligatorio.")
    if not nombre:
        raise ValueError("El nombre del producto es obligatorio.")

    try:
        precio = Decimal(precio_venta)
        stock = int(stock_actual)
        minimo = int(stock_minimo)
        categoria = int(id_categoria)
    except (InvalidOperation, ValueError):
        raise ValueError("Precio y stocks deben ser números válidos.")

    if not precio.is_finite() or precio < 0:
        raise ValueError("El precio debe ser mayor o igual a cero.")
    if stock < 0 or minimo < 0:
        raise ValueError("Los stocks no pueden ser negativos.")
    if categoria <= 0:
        raise ValueError("Selecciona una categoría válida.")

    return codigo, nombre, precio, stock, minimo, categoria

@app.route("/productos/nuevo", methods=["GET", "POST"])
def productos_nuevo():
    if request.method == "POST":
        codigo = request.form.get("codigo", "").strip()
        nombre = request.form.get("nombre", "").strip()
        precio_venta = request.form.get("precio_venta", "").strip()
        stock_actual = request.form.get("stock_actual", "").strip()
        stock_minimo = request.form.get("stock_minimo", "").strip()
        id_categoria = request.form.get("id_categoria", "").strip()

        try:
            codigo, nombre, precio_venta, stock_actual, stock_minimo, id_categoria = validar_datos_producto(
                codigo,
                nombre,
                precio_venta,
                stock_actual,
                stock_minimo,
                id_categoria
            )
        except ValueError as error:
            flash(str(error), "warning")
            return redirect(url_for("productos_nuevo"))

        conexion = None
        cursor = None
        try:
            conexion = obtener_conexion()
            cursor = conexion.cursor()
            cursor.execute("""
                INSERT INTO producto
                    (codigo, nombre, precio_venta, stock_actual, stock_minimo, id_categoria)
                VALUES (%s, %s, %s, %s, %s, %s)
            """, (codigo, nombre, precio_venta, stock_actual, stock_minimo, id_categoria))
            conexion.commit()
            flash(f"Producto '{nombre}' agregado exitosamente.", "success")
            return redirect(url_for("productos"))
        except Exception as e:
            if conexion:
                conexion.rollback()
            flash(f"Error al registrar producto: {e}", "danger")
        finally:
            if cursor:
                cursor.close()
            if conexion:
                conexion.close()

    categorias = []
    conexion = None
    cursor = None
    try:
        conexion = obtener_conexion()
        cursor = conexion.cursor()
        cursor.execute("SELECT id_categoria, nombre FROM categoria ORDER BY nombre")
        categorias = cursor.fetchall()
    except Exception as error:
        flash(f"No se pudieron cargar las categorías: {error}", "danger")
    finally:
        if cursor:
            cursor.close()
        if conexion:
            conexion.close()

    categorias_html = "".join(
        f'<option value="{int(id_categoria)}">{html.escape(str(nombre))}</option>'
        for id_categoria, nombre in categorias
    )

    mensajes_html = ""
    for categoria, mensaje in get_flashed_messages(with_categories=True):
        mensajes_html += f"""
        <div class="alert alert-{categoria} alert-dismissible fade show" role="alert">
            {html.escape(mensaje)}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
        """

    return f"""
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Nuevo Producto</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light">
        <div class="container mt-4" style="max-width: 600px;">
            <a href="/productos" class="btn btn-outline-secondary mb-3">⬅ Cancelar y Volver</a>
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white py-3">
                    <h3 class="h5 mb-0">+ Registrar Nuevo Producto</h3>
                </div>
                <div class="card-body p-4">
                    {mensajes_html}
                    <form method="POST" action="/productos/nuevo">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Código:</label>
                            <input type="text" name="codigo" class="form-control" placeholder="Ej: P001" required autofocus>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre del Producto:</label>
                            <input type="text" name="nombre" class="form-control" placeholder="Ej: Martillo Galponero" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Precio de Venta ($):</label>
                                <input type="number" step="0.01" min="0" name="precio_venta" class="form-control" placeholder="0.00" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stock Inicial:</label>
                                <input type="number" step="1" min="0" name="stock_actual" class="form-control" placeholder="0" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stock Mínimo:</label>
                                <input type="number" step="1" min="0" name="stock_minimo" class="form-control" value="0" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="id_categoria">Categoría:</label>
                            <select id="id_categoria" name="id_categoria" class="form-select" required>
                                <option value="">Selecciona una categoría</option>
                                {categorias_html}
                            </select>
                        </div>
                        <div class="d-grid mt-3">
                            <button type="submit" class="btn btn-success btn-lg">💾 Guardar Producto</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
    </html>
    """


# =====================================
# CRUD PRODUCTOS: EDITAR
# =====================================

@app.route("/productos/editar/<codigo>", methods=["GET", "POST"])
def productos_editar(codigo):
    conexion = None
    cursor = None

    if request.method == "POST":
        nombre = request.form.get("nombre", "").strip()
        precio_venta = request.form.get("precio_venta", "").strip()
        stock_actual = request.form.get("stock_actual", "").strip()
        stock_minimo = request.form.get("stock_minimo", "").strip()
        id_categoria = request.form.get("id_categoria", "").strip()

        try:
            _, nombre, precio_venta, stock_actual, stock_minimo, id_categoria = validar_datos_producto(
                codigo,
                nombre,
                precio_venta,
                stock_actual,
                stock_minimo,
                id_categoria,
                requiere_codigo=False
            )
        except ValueError as error:
            flash(str(error), "warning")
            return redirect(url_for("productos_editar", codigo=codigo))

        try:
            conexion = obtener_conexion()
            cursor = conexion.cursor()
            cursor.execute("""
                UPDATE producto
                SET nombre = %s,
                    precio_venta = %s,
                    stock_actual = %s,
                    stock_minimo = %s,
                    id_categoria = %s
                WHERE codigo = %s
            """, (nombre, precio_venta, stock_actual, stock_minimo, id_categoria, codigo))
            conexion.commit()
            flash(f"Producto '{codigo}' actualizado correctamente.", "success")
            return redirect(url_for("productos"))
        except Exception as e:
            if conexion:
                conexion.rollback()
            flash(f"Error al actualizar producto: {e}", "danger")
        finally:
            if cursor:
                cursor.close()
            if conexion:
                conexion.close()

    producto = None
    try:
        conexion = obtener_conexion()
        cursor = conexion.cursor()
        cursor.execute("""
            SELECT codigo, nombre, precio_venta, stock_actual, stock_minimo, id_categoria
            FROM producto
            WHERE codigo = %s
        """, (codigo,))
        producto = cursor.fetchone()
    except Exception as e:
        flash(f"Error al obtener el producto: {e}", "danger")
    finally:
        if cursor:
            cursor.close()
        if conexion:
            conexion.close()

    categorias = []
    conexion = None
    cursor = None
    try:
        conexion = obtener_conexion()
        cursor = conexion.cursor()
        cursor.execute("SELECT id_categoria, nombre FROM categoria ORDER BY nombre")
        categorias = cursor.fetchall()
    except Exception as error:
        flash(f"No se pudieron cargar las categorías: {error}", "danger")
    finally:
        if cursor:
            cursor.close()
        if conexion:
            conexion.close()

    if not producto:
        flash("El producto no existe.", "warning")
        return redirect(url_for("productos"))

    prod_codigo = html.escape(str(producto[0]))
    prod_nombre = html.escape(str(producto[1]))
    prod_precio = html.escape(str(producto[2]))
    prod_stock = html.escape(str(producto[3]))
    prod_stock_minimo = html.escape(str(producto[4]))
    id_categoria_actual = int(producto[5])
    categorias_html = "".join(
        f'<option value="{int(id_categoria)}"'
        f'{" selected" if int(id_categoria) == id_categoria_actual else ""}>'
        f'{html.escape(str(nombre))}</option>'
        for id_categoria, nombre in categorias
    )

    mensajes_html = ""
    for categoria, mensaje in get_flashed_messages(with_categories=True):
        mensajes_html += f"""
        <div class="alert alert-{categoria} alert-dismissible fade show" role="alert">
            {html.escape(mensaje)}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
        """

    return f"""
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Editar Producto</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light">
        <div class="container mt-4" style="max-width: 600px;">
            <a href="/productos" class="btn btn-outline-secondary mb-3">⬅ Cancelar y Volver</a>
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h3 class="h5 mb-0">✏ Editar Producto: {prod_codigo}</h3>
                </div>
                <div class="card-body p-4">
                    {mensajes_html}
                    <form method="POST" action="/productos/editar/{prod_codigo}">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Código:</label>
                            <input type="text" class="form-control" value="{prod_codigo}" disabled readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre del Producto:</label>
                            <input type="text" name="nombre" class="form-control" value="{prod_nombre}" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Precio de Venta ($):</label>
                                <input type="number" step="0.01" min="0" name="precio_venta" class="form-control" value="{prod_precio}" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stock Actual:</label>
                                <input type="number" step="1" min="0" name="stock_actual" class="form-control" value="{prod_stock}" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stock Mínimo:</label>
                                <input type="number" step="1" min="0" name="stock_minimo" class="form-control" value="{prod_stock_minimo}" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="id_categoria">Categoría:</label>
                            <select id="id_categoria" name="id_categoria" class="form-select" required>
                                {categorias_html}
                            </select>
                        </div>
                        <div class="d-grid mt-3">
                            <button type="submit" class="btn btn-primary btn-lg">💾 Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
    </html>
    """


# =====================================
# CRUD PRODUCTOS: ELIMINAR
# =====================================

@app.route("/productos/eliminar/<codigo>", methods=["POST"])
def productos_eliminar(codigo):
    conexion = None
    cursor = None
    try:
        conexion = obtener_conexion()
        cursor = conexion.cursor()
        cursor.execute("DELETE FROM producto WHERE codigo = %s", (codigo,))
        conexion.commit()
        flash(f"Producto '{codigo}' eliminado correctamente.", "success")
    except Exception as e:
        if conexion:
            conexion.rollback()
        flash(f"Error al eliminar producto: {e}", "danger")
    finally:
        if cursor:
            cursor.close()
        if conexion:
            conexion.close()

    return redirect(url_for("productos"))


