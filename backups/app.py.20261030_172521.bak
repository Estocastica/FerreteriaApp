from decimal import Decimal, InvalidOperation
from flask import Flask, request, redirect, url_for, flash, get_flashed_messages
from mysql.connector import pooling
import html

app = Flask(__name__)
app.secret_key = "ferreteria_secret_key_prod"

# =====================================
# POOL DE CONEXIONES A MYSQL
# =====================================

db_config = {
    "host": "localhost",
    "port": 3307,
    "user": "root",
    "password": "1234",
    "database": "ferreteria"
}

try:
    db_pool = pooling.MySQLConnectionPool(
        pool_name="ferreteria_pool",
        pool_size=5,
        pool_reset_session=True,
        **db_config
    )
    print("Pool de conexiones a MySQL iniciado correctamente")
except Exception as e:
    print(f"Error al iniciar el pool de conexiones: {e}")
    db_pool = None


def obtener_conexion():
    if db_pool is None:
        raise Exception("El pool de base de datos no está disponible.")
    return db_pool.get_connection()


# =====================================
# REGISTRO OPCIONAL DE BLUEPRINTS
# =====================================

try:
    from proveedores import proveedores_bp
    app.register_blueprint(proveedores_bp)
except ImportError:
    pass


