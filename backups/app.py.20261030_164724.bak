from flask import Flask
from mysql.connector import pooling
import html

app = Flask(__name__)
app.secret_key = "ferreteria_secret_key_prod"

# =====================================
# POOL DE CONEXIONES A MYSQL
# =====================================

db_config = {
    "host": "localhost",
    "port": 3307,
    "user": "root",
    "password": "1234",
    "database": "ferreteria"
}

try:
    db_pool = pooling.MySQLConnectionPool(
        pool_name="ferreteria_pool",
        pool_size=5,
        pool_reset_session=True,
        **db_config
    )
    print("✅ Pool de conexiones a MySQL iniciado correctamente")
except Exception as e:
    print(f"❌ Error al iniciar el pool de conexiones: {e}")
    db_pool = None

# =====================================
# REGISTRO DE BLUEPRINTS (MÓDULOS)
# =====================================

from proveedores import proveedores_bp
app.register_blueprint(proveedores_bp)


# =====================================
# MENÚ PRINCIPAL
# =====================================

@app.route("/")
def inicio():
    return """
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <title>Ferretería CANJER</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light">
        <div class="container mt-5">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h1>🔨 Ferretería CANJER</h1>
                </div>
                <div class="card-body">
                    <h3>Menú Principal</h3>
                    <hr>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="/productos" class="btn btn-primary btn-lg">
                            📦 Productos
                        </a>
                        <a href="/clientes" class="btn btn-success btn-lg">
                            👥 Clientes
                        </a>
                        <a href="/proveedores" class="btn btn-info text-white btn-lg">
                            🚚 Proveedores
                        </a>
                        <a href="/alertas" class="btn btn-warning btn-lg">
                            ⚠ Alertas
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </body>
    </html>
    """


# =====================================
# PRODUCTOS
# =====================================

@app.route("/productos")
def productos():
    conexion = None
    cursor = None
    filas = []

    try:
        conexion = db_pool.get_connection()
        cursor = conexion.cursor()
        cursor.execute("""
            SELECT codigo,
                   nombre,
                   precio_venta,
                   stock_actual
            FROM producto
            ORDER BY nombre
        """)
        filas = cursor.fetchall()
    except Exception as e:
        print("❌ Error en productos:", e)
    finally:
        if cursor:
            cursor.close()
        if conexion:
            conexion.close()

    filas_html = ""
    for fila in filas:
        filas_html += f"""
        <tr>
            <td>{html.escape(str(fila[0]))}</td>
            <td>{html.escape(str(fila[1]))}</td>
            <td>${html.escape(str(fila[2]))}</td>
            <td>{html.escape(str(fila[3]))}</td>
        </tr>
        """

    return f"""
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <title>Productos</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light">
        <div class="container mt-4">
            <a href="/" class="btn btn-secondary mb-3">🏠 Volver al menú</a>
            <h1>📦 Productos</h1>
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Precio</th>
                        <th>Stock</th>
                    </tr>
                </thead>
                <tbody>
                    {filas_html}
                </tbody>
            </table>
        </div>
    </body>
    </html>
    """


# =====================================
# CLIENTES
# =====================================

@app.route("/clientes")
def clientes():
    conexion = None
    cursor = None
    filas = []

    try:
        conexion = db_pool.get_connection()
        cursor = conexion.cursor()
        cursor.execute("""
            SELECT nombre,
                   tipo,
                   limite_credito
            FROM cliente
            ORDER BY nombre
        """)
        filas = cursor.fetchall()
    except Exception as e:
        print("❌ Error en clientes:", e)
    finally:
        if cursor:
            cursor.close()
        if conexion:
            conexion.close()

    filas_html = ""
    for fila in filas:
        filas_html += f"""
        <tr>
            <td>{html.escape(str(fila[0]))}</td>
            <td>{html.escape(str(fila[1]))}</td>
            <td>${html.escape(str(fila[2]))}</td>
        </tr>
        """

    return f"""
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <title>Clientes</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light">
        <div class="container mt-4">
            <a href="/" class="btn btn-secondary mb-3">🏠 Volver al menú</a>
            <h1>👥 Clientes</h1>
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Límite Crédito</th>
                    </tr>
                </thead>
                <tbody>
                    {filas_html}
                </tbody>
            </table>
        </div>
    </body>
    </html>
    """


# =====================================
# ALERTAS
# =====================================

@app.route("/alertas")
def alertas():
    conexion = None
    cursor = None
    filas = []

    try:
        conexion = db_pool.get_connection()
        cursor = conexion.cursor()
        cursor.execute("""
            SELECT codigo,
                   producto,
                   stock_actual,
                   stock_minimo
            FROM v_stock_a_reponer
        """)
        filas = cursor.fetchall()
    except Exception as e:
        print("❌ Error en alertas:", e)
    finally:
        if cursor:
            cursor.close()
        if conexion:
            conexion.close()

    filas_html = ""
    for fila in filas:
        filas_html += f"""
        <tr>
            <td>{html.escape(str(fila[0]))}</td>
            <td>{html.escape(str(fila[1]))}</td>
            <td>{html.escape(str(fila[2]))}</td>
            <td>{html.escape(str(fila[3]))}</td>
        </tr>
        """

    return f"""
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8">
        <title>Alertas</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light">
        <div class="container mt-4">
            <a href="/" class="btn btn-secondary mb-3">🏠 Volver al menú</a>
            <h1>⚠ Productos a Reponer</h1>
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-danger">
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Stock</th>
                        <th>Mínimo</th>
                    </tr>
                </thead>
                <tbody>
                    {filas_html}
                </tbody>
            </table>
        </div>
    </body>
    </html>
    """


# =====================================
# EJECUCIÓN
# =====================================

if __name__ == "__main__":
    app.run(debug=True)
